<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="720.0" prefWidth="1280.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vault.crack.bit_bandits_hack.LockPickController">
   <children>
      <Pane fx:id="lockChamber" prefHeight="720.0" prefWidth="1280.0">
         <children>
            <!-- Layer 1: Base Background Graphic -->
            <ImageView fitHeight="739.0" fitWidth="1294.0">
               <image>
                  <Image url="@../images/lock_picking_lvl2_BASE.png" />
               </image>
            </ImageView>

            <!-- Layer 2: Overlay Shadow -->
            <Rectangle arcHeight="5.0" arcWidth="5.0" height="749.0" layoutY="-10.0" opacity="0.34" stroke="BLACK" strokeType="INSIDE" width="1295.0" />

            <!-- Layer 3: Keyhole Graphic -->
            <ImageView fitHeight="748.0" fitWidth="1288.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/lock_picking_lvl2_KEYHOLE.png" />
               </image>
            </ImageView>

            <!-- Layer 4: Invisible Track Collision Bounds -->
            <Rectangle fx:id="shaftTrack" layoutX="330.0" layoutY="450.0" width="620.0" height="70.0" fill="transparent" />
            <Rectangle fx:id="notch1" layoutX="360.0" layoutY="280.0" width="80.0" height="170.0" fill="transparent" />
            <Rectangle fx:id="notch2" layoutX="520.0" layoutY="280.0" width="80.0" height="170.0" fill="transparent" />
            <Rectangle fx:id="notch3" layoutX="680.0" layoutY="280.0" width="80.0" height="170.0" fill="transparent" />

            <!-- Layer 5: Interactive Lock Pick Tool -->
            <Group fx:id="pickTool" layoutX="920.0" layoutY="485.0" style="-fx-cursor: hand;">
               <!-- Metallic Shaft -->
               <Line startX="0.0" startY="0.0" endX="-220.0" endY="0.0" stroke="#007acc" strokeWidth="16.0" strokeLineCap="ROUND" />
               <!-- Pick Tip (Fixed property names) -->
               <Circle centerX="-220.0" centerY="0.0" radius="14.0" fill="#00d2ff" stroke="#ffffff" strokeWidth="3.0" />
            </Group>

            <!-- Layer 6: Visual Feedback Cue (Pin Dots Indicator) -->
            <HBox alignment="CENTER" layoutX="30.0" layoutY="30.0" spacing="15.0"
                  style="-fx-background-color: rgba(0,0,0,0.6); -fx-padding: 10 20; -fx-background-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="PINS SET:" />
                  <Circle fx:id="pin1" radius="10.0" fill="#444444" stroke="#888888" strokeWidth="2.0" />
                  <Circle fx:id="pin2" radius="10.0" fill="#444444" stroke="#888888" strokeWidth="2.0" />
                  <Circle fx:id="pin3" radius="10.0" fill="#444444" stroke="#888888" strokeWidth="2.0" />
               </children>
            </HBox>

            <!-- Status Message Overlay -->
            <Label fx:id="statusLabel" layoutX="30.0" layoutY="85.0"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffdd00; -fx-effect: dropshadow(three-pass-box, black, 5, 0, 0, 0);"
                   text="Drag the blue pick to set all 3 top pins. Don't hit the walls!" />

            <!-- Layer 7: Transition Button to Laser Heist -->
            <Button fx:id="nextLevelButton" text="Proceed to Laser Heist →"
                    disable="true"
                    onAction="#switchToLaserHeist"
                    layoutX="1020.0"
                    layoutY="30.0"
                    style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #222222; -fx-text-fill: #ffffff; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand;" />
         </children>
      </Pane>
   </children>
</VBox>